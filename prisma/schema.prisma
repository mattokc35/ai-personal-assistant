generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reminder {
  id        Int      @id @default(autoincrement())
  title     String
  datetime  DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model Memory {
  id        Int      @id @default(autoincrement())
  key       String?
  content   String
  createdAt DateTime @default(now())
}
